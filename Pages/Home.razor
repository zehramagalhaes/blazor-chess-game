@page "/"
@using BlazorChessWebApp.Core.Controllers

<PageTitle>Royal Chess - Medieval Realm</PageTitle>

<div class="realm-app-wrapper">
    <!-- Checkmate modal -->
    @if (_controller.IsCheckmate)
    {
        <div class="rpg-modal-overlay">
            <div class="rpg-modal parchment-card victory-modal">
                <div class="modal-ornament">👑</div>
                <h2 class="modal-title">
                    @(_controller.CurrentTurn == PieceColor.White ? "VICTORY FOR THE BLACK EMPIRE" : "VICTORY FOR THE WHITE KINGDOM")
                </h2>
                <p class="modal-quote">
                    @(_controller.CurrentTurn == PieceColor.White 
                        ? "\"The White King falls to the shadows. The Empire claims the realm!\"" 
                        : "\"The forces of light have crushed the darkness. The Black King is captured!\"")
                </p>
                <div class="modal-actions">
                    <button class="rpg-btn-large" @onclick="_controller.StartNewGame">
                        <span class="btn-icon">⚔️</span>
                        FORGE A NEW BATTLE
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Tie modal -->
    @if (_controller.IsDraw)
    {
        <div class="rpg-modal-overlay">
            <div class="rpg-modal parchment-card draw-modal">
                <div class="modal-ornament">🤝</div>
                <h2 class="modal-title">TRUCE ON THE BATTLEFIELD</h2>
                <p class="modal-quote">
                    @if (_controller.DrawReason == DrawReason.Stalemate)
                    {
                        <span>"The monarch is cornered! The armies are paralyzed in an eternal stalemate."</span>
                    }
                    else if (_controller.DrawReason == DrawReason.FiftyMoveRule)
                    {
                        <span>"Exhaustion consumes the soldiers. After 50 marches in vain, peace is sealed."</span>
                    }
                    else if (_controller.DrawReason == DrawReason.InsufficientMaterial)
                    {
                        <span>"Swords have broken and shields have fallen. No strength remains to claim victory."</span>
                    }
                    else
                    {
                        <span>"The gods have intervened. The battle ends with no victor."</span>
                    }
                </p>
                <div class="modal-actions">
                    <button class="rpg-btn-large" @onclick="_controller.StartNewGame">
                        <span class="btn-icon">🛡️</span>
                        SUMMON NEW ARMIES
                    </button>
                </div>
            </div>
        </div>
    }
    
    <!-- Medieval RPG Navigation Banner -->
    <header class="rpg-navbar">
        <div class="navbar-brand">
            <div class="brand-crest">
                <span class="crest-icon">⚔️</span>
            </div>
            <div class="brand-details">
                <h1 class="brand-title">ROYAL CHESS</h1>
                <span class="brand-subtitle">MEDIEVAL REALM v10.0</span>
            </div>
        </div>

        <div class="navbar-status">
            <div class="turn-banner @(_controller.CurrentTurn == PieceColor.White ? "white-turn" : "black-turn")">
                <span class="status-gem"></span>
                <span class="turn-title">@(_controller.CurrentTurn == PieceColor.White ? "WHITE KINGDOM" : "BLACK EMPIRE")</span>
            </div>

            @if (_controller is { IsInCheck: true, IsCheckmate: false })
            {
                <div class="check-banner">
                    <span class="check-icon">🔥</span>
                    <span class="check-text">KING IN CHECK!</span>
                </div>
            }

            @if (_controller.IsCheckmate)
            {
                <div class="check-banner victory-banner">
                    <span class="check-icon">👑</span>
                    <span class="check-text">CHECKMATE!</span>
                </div>
            }
        </div>

        <div class="navbar-actions">
            <button class="rpg-btn btn-new-game" @onclick="_controller.StartNewGame">
                <span class="btn-icon">⚔️</span>
                <span>NEW BATTLE</span>
            </button>
        </div>
    </header>

    <!-- Main Game Realm Workspace -->
    <main class="game-realm-workspace">
        @if (_controller.IsPromoting)
    {
        <div class="promotion-overlay">
            <div class="promotion-modal parchment-card">
                <h2 class="card-title">A new noble is born!</h2>
                <p>Choose your new noble piece:</p>
                <div class="promotion-options">
                    <button class="rpg-btn-choice @(_controller.CurrentTurn == PieceColor.White ? "btn-white-piece" : "btn-black-piece")" @onclick="() => _controller.PromotePawn(PieceType.Queen)">
                        <img src="@_controller.GetPieceAssetPathByColorAndType(_controller.CurrentTurn, PieceType.Queen)" alt="Queen" />
                        <span>QUEEN</span>
                    </button>
                    <button class="rpg-btn-choice @(_controller.CurrentTurn == PieceColor.White ? "btn-white-piece" : "btn-black-piece")" @onclick="() => _controller.PromotePawn(PieceType.Rook)">
                        <img src="@_controller.GetPieceAssetPathByColorAndType(_controller.CurrentTurn, PieceType.Rook)" alt="Rook" />
                        <span>ROOK</span>
                    </button>
                    <button class="rpg-btn-choice @(_controller.CurrentTurn == PieceColor.White ? "btn-white-piece" : "btn-black-piece")" @onclick="() => _controller.PromotePawn(PieceType.Bishop)">
                        <img src="@_controller.GetPieceAssetPathByColorAndType(_controller.CurrentTurn, PieceType.Bishop)" alt="Bishop" />
                        <span>BISHOP</span>
                    </button>
                    <button class="rpg-btn-choice @(_controller.CurrentTurn == PieceColor.White ? "btn-white-piece" : "btn-black-piece")" @onclick="() => _controller.PromotePawn(PieceType.Knight)">
                        <img src="@_controller.GetPieceAssetPathByColorAndType(_controller.CurrentTurn, PieceType.Knight)" alt="Knight" />
                        <span>KNIGHT</span>
                    </button>
                </div>
            </div>
        </div>
    }
        <!-- Classic Wooden Chessboard Frame -->
        <div class="wooden-board-container">
            <div class="board-frame">
                <div class="rank-sidebar">
                    @for (int r = 8; r >= 1; r--)
                    {
                        <div class="rank-cell">@r</div>
                    }
                </div>
                <div class="board-grid">
                    @for (int row = 0; row < 8; row++)
                    {
                        for (int col = 0; col < 8; col++)
                        {
                            int r = row;
                            int c = col;
                            var currentPos = new Position(r, c);
                            var piece = _controller.Board.GetPieceAt(currentPos);

                            bool isDark = (r + c) % 2 != 0;
                            string squareClass = isDark ? "square dark-square" : "square light-square";

                            if (_controller.SelectedPosition == currentPos)
                                squareClass += " square-selected";
                            if (_controller.ValidMoves.Contains(currentPos))
                                squareClass += " square-valid";

                            <div class="@squareClass" @onclick="() => _controller.HandleSquareClick(r, c)">
                                @if (piece != null)
                                {
                                    <img src="@_controller.GetPieceAssetPath(piece)" 
                                         alt="@piece.Color @piece.Type" 
                                         class="piece-asset" />
                                }
                            </div>
                        }
                    }
                </div>
            </div>
            <div class="file-footer">
                @foreach (var file in new[] { "A", "B", "C", "D", "E", "F", "G", "H" })
                {
                    <div class="file-cell">@file</div>
                }
            </div>
        </div>

        <!-- RPG Parchment Sidebar Panel -->
        <aside class="rpg-sidebar">
            <!-- Captured Spoils -->
            <section class="parchment-card captured-card">
                <div class="card-header">
                    <h3 class="card-title">Captured Spoils</h3>
                </div>
                <div class="captured-body">
                    <div class="captured-group">
                        <span class="captured-label">White:</span>
                        <div class="captured-list">
                            @if (_controller.WhiteCapturedPieces.Count == 0)
                            {
                                <span class="empty-text">—</span>
                            }
                            else
                            {
                                @foreach (var p in _controller.WhiteCapturedPieces)
                                {
                                    <img src="@_controller.GetPieceAssetPath(p)" class="captured-piece-asset" alt="@p.Type" />
                                }
                            }
                        </div>
                    </div>
                    <div class="captured-group">
                        <span class="captured-label">Black:</span>
                        <div class="captured-list">
                            @if (_controller.BlackCapturedPieces.Count == 0)
                            {
                                <span class="empty-text">—</span>
                            }
                            else
                            {
                                @foreach (var p in _controller.BlackCapturedPieces)
                                {
                                    <img src="@_controller.GetPieceAssetPath(p)" class="captured-piece-asset" alt="@p.Type" />
                                }
                            }
                        </div>
                    </div>
                </div>
            </section>

            <!-- Battle Chronicle / Move History -->
            <section class="parchment-card log-card">
                <div class="card-header">
                    <h3 class="card-title">Battle Chronicle</h3>
                    <span class="log-counter">Turn @_controller.MoveHistory.Count</span>
                </div>
                <div class="log-body custom-scroll">
                    @if (_controller.MoveHistory.Count == 0)
                    {
                        <div class="empty-log">The battle awaits. White Kingdom takes the first move.</div>
                    }
                    else
                    {
                        @foreach (var log in _controller.MoveHistory)
                        {
                            <div class="log-item @_controller.GetLogCssClass(log.Type)">
                                <span class="log-timestamp">@log.Timestamp.ToString("HH:mm:ss")</span>
                                <span class="log-message">@log.Message</span>
                            </div>
                        }
                    }
                </div>
            </section>
        </aside>
    </main>
</div>

@code {
    private readonly GameController _controller = new GameController();
}